# Template. bootstrap.sh replaces __HOST__ with <ip-with-dashes>.nip.io.
# No access log is enabled. The default (error and runtime) log still redacts the API key,
# since error entries can carry the request.
# On-box check: stop iris, send one keyed request (header and ?key=), then
#   journalctl -u caddy | grep -i iris-key
# must print nothing, and `journalctl -u caddy | grep "key="` must show no real key.
# The admin API is a unix socket owned by caddy (mode 0600 by default), so the iris
# process cannot reach it. `systemctl reload caddy` runs `caddy reload --config
# /etc/caddy/Caddyfile`, which reads this admin address from the config.
{
	admin unix//run/caddy/admin.sock
	log default {
		format filter {
			wrap console
			request>uri query {
				replace key REDACTED
			}
			request>headers>X-Iris-Key delete
		}
	}
}

__HOST__ {
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:8000
}
