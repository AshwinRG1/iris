# On the box these variables live in /etc/iris.env (mode 600, root-owned), which systemd
# loads. Settings reads no env file itself. A laptop exports the variables, or runs
# `uvicorn main:app --env-file <file>` with LOG_DIR=logs. Never commit the real file.
# systemd EnvironmentFile: one KEY=value per line, comments on their own lines only.

# yolo or zeroshot
DETECTOR=yolo
# Stock YOLO26s is resolved from the working directory. On the box that is
# /opt/iris/models, where bootstrap pre-places yolo26s.pt. For trained weights, scp
# best.pt there as root (the service must not be able to rewrite weights), run
# `chown root:root /opt/iris/models/best.pt`, and set MODEL_PATH=best.pt.
MODEL_PATH=yolo26s.pt
IMGSZ=640
# Empty: CUDA, then MPS, then CPU
DEVICE=
CONF_DETECT=0.25
# Comma-separated
ALERT_LABELS=person

# Alert policy tuning
CONF_ALERT=0.35
WINDOW=3
NEEDED=2
COOLDOWN_S=4
SAME_SIDE_REPEAT_S=10
WINDOW_MAX_AGE_S=2

# Whole request body cap in bytes, multipart framing included. Caddy caps at 2MB too.
MAX_UPLOAD_BYTES=2000000

# REQUIRED on the box, at least 32 characters, on exactly one line. Bootstrap refuses to
# finish and the service refuses to start otherwise.
# Empty means no key checks anywhere, which is only acceptable on a laptop.
IRIS_API_KEY=

# Absolute on the box (bootstrap creates it, owned by iris). Use logs for a laptop.
LOG_DIR=/opt/iris/logs
# Set by bootstrap to the deployed commit. Leave empty on a laptop.
IRIS_COMMIT=
